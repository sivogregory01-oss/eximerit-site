{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eximerit-site",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-02",
  "observability": { "enabled": true },
  "assets": { "directory": "." },
  "routes": [
    { "pattern": "eximerit.com", "custom_domain": true },
    { "pattern": "www.eximerit.com", "custom_domain": true }
  ]
}
